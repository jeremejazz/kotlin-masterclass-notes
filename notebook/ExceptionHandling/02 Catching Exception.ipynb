   "source": [
    "# Catching Exceptions\n",
    "\n",
    "Exceptions\n",
    "1. Error Reporting\n",
    "2. Recovery\n",
    "3. Resource Cleanup\n",
    "\n",
    "\n",
    "```kotlin\n",
    "\n",
    "try{\n",
    "    function1()\n",
    "}catch(e: Throwable){\n",
    "    println(\"Exception Caught: ${e.message}\")\n",
    "}\n",
    "finally{\n",
    "    println(\"cleanup\")\n",
    "}\n",
    "```"
   ],
